{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JasonColapietro/suede-skills-mcp",
  "title": "Suede AI Skills MCP",
  "description": "Routes tasks to Suede skills, grades live pages A-F for Google and AI search, and checks copy.",
  "version": "0.19.3",
  "websiteUrl": "https://skills.suedeai.ai/",
  "repository": {
    "url": "https://github.com/JasonColapietro/suede-creator-skills",
    "source": "github",
    "subfolder": "mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "suede-skills-mcp",
      "version": "0.19.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--profile",
          "description": "Which skills to expose: all, a bundle area, or one specialty.",
          "isRequired": false,
          "default": "all",
          "choices": [
            "all",
            "workflow",
            "creator",
            "marketing",
            "ship",
            "craft",
            "found",
            "demand",
            "revenue",
            "position"
          ]
        }
      ]
    }
  ]
}
