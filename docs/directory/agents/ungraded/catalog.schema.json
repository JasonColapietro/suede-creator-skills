{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ungraded agent discovery catalog",
  "description": "Listing facts only. No grades, ratings, badges or runtime/security assessment. Runtime validation also enforces public URLs, source dates and cross-catalog product uniqueness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "tasks",
          "deployments",
          "sourceAvailability",
          "officialUrl",
          "repositoryUrl",
          "sourceUrls",
          "observedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "deployments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "local",
                "self-hosted",
                "hosted"
              ]
            }
          },
          "sourceAvailability": {
            "enum": [
              "public-source",
              "not-reviewed"
            ]
          },
          "officialUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "repositoryUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceUrls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
