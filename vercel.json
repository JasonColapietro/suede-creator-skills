{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install step: the build uses only Node built-ins'",
  "buildCommand": "node scripts/build-vercel.mjs",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] && exit 0 || exit 1",
  "outputDirectory": "dist/out",
  "trailingSlash": true,
  "redirects": [
    { "source": "/directory", "destination": "https://suedeai.directory/", "permanent": true },
    { "source": "/directory/:path*", "destination": "https://suedeai.directory/:path*", "permanent": true }
  ]
}
